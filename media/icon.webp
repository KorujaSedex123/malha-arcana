<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="256" height="256">
  <defs>
    <radialGradient id="bg" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#2e1065"/>
      <stop offset="60%" stop-color="#0f0728"/>
      <stop offset="100%" stop-color="#050212"/>
    </radialGradient>
    <linearGradient id="rune" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c084fc"/>
      <stop offset="50%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <rect width="256" height="256" rx="32" fill="url(#bg)" stroke="#7e22ce" stroke-width="4"/>
  <circle cx="128" cy="128" r="96" fill="none" stroke="#581c87" stroke-width="2" stroke-dasharray="6,6"/>
  <circle cx="128" cy="128" r="80" fill="none" stroke="url(#rune)" stroke-width="3" filter="url(#glow)"/>
  <!-- Arcane Octagram / Weave -->
  <polygon points="128,40 190,190 40,100 216,100 66,190" fill="none" stroke="url(#rune)" stroke-width="3" filter="url(#glow)"/>
  <circle cx="128" cy="128" r="28" fill="#581c87" fill-opacity="0.4" stroke="#c084fc" stroke-width="2"/>
  <polygon points="128,110 144,128 128,146 112,128" fill="#e9d5ff"/>
  <circle cx="128" cy="128" r="4" fill="#06b6d4"/>
</svg>